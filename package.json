{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "duxt-starter",
  "version": "0.0.0",
  "description": "Minimal Nuxt documentation site built on the duxt layer — clone it with `nuxi init -t github:kirchDev/duxt-starter`.",
  "keywords": [
    "documentation",
    "duxt",
    "kirchdev",
    "nuxt",
    "nuxt-content",
    "starter",
    "template"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate"
  },
  "dependencies": {
    "@kirchdev/duxt": "^0.1.0",
    "nuxt": "^4.5.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
